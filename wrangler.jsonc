{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasktracker-pwa",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
